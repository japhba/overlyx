{
  "name": "overlyx-vscode",
  "displayName": "OverLyX",
  "description": "LyX-style WYSIWYG editing for LaTeX .tex files — the OverLyX editor inside VS Code: rendered text and formulas, LyX keybindings, change tracking, comments, outline, PDF preview with SyncTeX. File browsing, git and agents stay VS Code's.",
  "version": "0.2.3",
  "publisher": "overlyx",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/japhba/overlyx"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "overlyx.texEditor",
        "displayName": "OverLyX Editor",
        "selector": [
          {
            "filenamePattern": "*.tex"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "overlyx.openInOverlyx",
        "title": "Open in OverLyX Editor",
        "category": "OverLyX",
        "icon": "$(preview)"
      },
      {
        "command": "overlyx.openAsText",
        "title": "Open as LaTeX Source (text editor)",
        "category": "OverLyX",
        "icon": "$(go-to-file)"
      },
      {
        "command": "overlyx.buildPdf",
        "title": "Build & View PDF",
        "category": "OverLyX",
        "icon": "$(file-pdf)"
      },
      {
        "command": "overlyx.syncToPdf",
        "title": "SyncTeX: Show Cursor in PDF",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.toggleMargin",
        "title": "Toggle Notes & Comments in the Margin",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.refreshOutline",
        "title": "Refresh Structure",
        "category": "OverLyX",
        "icon": "$(refresh)"
      },
      {
        "command": "overlyx.checkForUpdates",
        "title": "Check for Updates",
        "category": "OverLyX"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overlyx",
          "title": "OverLyX",
          "icon": "assets/overlyx.svg"
        }
      ]
    },
    "views": {
      "overlyx": [
        {
          "id": "overlyx.structure",
          "name": "Structure",
          "contextualTitle": "OverLyX Structure"
        }
      ],
      "explorer": [
        {
          "id": "overlyx.structureExplorer",
          "name": "OverLyX Structure",
          "when": "overlyx.active",
          "contextualTitle": "OverLyX Structure"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "overlyx.openInOverlyx",
          "when": "resourceExtname == .tex && activeCustomEditorId != overlyx.texEditor",
          "group": "navigation"
        },
        {
          "command": "overlyx.openAsText",
          "when": "activeCustomEditorId == overlyx.texEditor",
          "group": "navigation"
        },
        {
          "command": "overlyx.buildPdf",
          "when": "activeCustomEditorId == overlyx.texEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "overlyx.refreshOutline",
          "when": "view == overlyx.structure",
          "group": "navigation"
        },
        {
          "command": "overlyx.refreshOutline",
          "when": "view == overlyx.structureExplorer",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "overlyx.buildPdf",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeCustomEditorId == overlyx.texEditor"
      },
      {
        "command": "overlyx.syncToPdf",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "activeCustomEditorId == overlyx.texEditor"
      }
    ],
    "configuration": {
      "title": "OverLyX",
      "properties": {
        "overlyx.layoutDir": {
          "type": "string",
          "default": "",
          "description": "Directory with LyX layout files. Empty: the copy bundled with the extension (or LYX_LAYOUT_DIR)."
        },
        "overlyx.latexmk": {
          "type": "string",
          "default": "latexmk",
          "description": "latexmk executable used to build PDFs."
        },
        "overlyx.defaultEditor": {
          "type": "boolean",
          "default": false,
          "description": "Open .tex files in the OverLyX editor by default (otherwise use “Reopen Editor With…” or the editor-title button)."
        },
        "overlyx.updates": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "default": "prompt",
          "description": "Self-update from GitHub releases (the extension is installed from a .vsix, so VS Code does not update it): ask before installing, install silently, or only check via the “OverLyX: Check for Updates” command."
        },
        "overlyx.updateRepo": {
          "type": "string",
          "default": "japhba/overlyx",
          "description": "GitHub repository (owner/name) whose releases provide updates."
        },
        "overlyx.updateApi": {
          "type": "string",
          "default": "",
          "description": "Override the release-check endpoint (testing / self-hosted mirrors). Leave empty."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build --config webview.vite.config.ts && node scripts/copy-assets.mjs",
    "build:host": "node esbuild.mjs",
    "build:webview": "vite build --config webview.vite.config.ts",
    "package": "vsce package --no-dependencies",
    "test:integration": "xvfb-run -a node test/runTest.mjs",
    "test:gui": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node test/guiTest.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
