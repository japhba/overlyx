{
  "name": "overlyx-vscode",
  "displayName": "OverLyX",
  "description": "LyX-style WYSIWYM editing for LaTeX .tex files (and markdown) — the OverLyX editor inside VS Code: rendered text and formulas, LyX keybindings, change tracking, comments, outline, PDF preview with SyncTeX. File browsing, git and agents stay VS Code's.",
  "version": "0.2.11",
  "publisher": "overlyx",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/japhba/overlyx"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git/HEAD"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "overlyx.pdfViewer",
        "displayName": "OverLyX PDF Viewer",
        "selector": [{ "filenamePattern": "*.pdf" }],
        "priority": "default"
      },
      {
        "viewType": "overlyx.texEditor",
        "displayName": "OverLyX Editor",
        "selector": [
          {
            "filenamePattern": "*.tex"
          },
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "overlyx.htmlEditor",
        "displayName": "OverLyX Slides, Poster, Web Page or Article",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "overlyx.openPdf",
        "title": "Open in OverLyX PDF Viewer",
        "category": "OverLyX",
        "icon": "$(file-pdf)"
      },
      {
        "command": "overlyx.newSlides",
        "title": "New Slide Deck…",
        "shortTitle": "Slide Deck",
        "category": "OverLyX",
        "icon": "$(preview)"
      },
      {
        "command": "overlyx.newPoster",
        "title": "New Poster…",
        "shortTitle": "Poster",
        "category": "OverLyX",
        "icon": "$(layout)"
      },
      {
        "command": "overlyx.newWebPage",
        "title": "New Web Page…",
        "shortTitle": "Web Page",
        "category": "OverLyX",
        "icon": "$(globe)"
      },
      {
        "command": "overlyx.openDeliverable",
        "title": "Open in OverLyX (slides, poster or web page)",
        "category": "OverLyX",
        "icon": "$(preview)"
      },
      {
        "command": "overlyx.newDocument",
        "title": "New Document…",
        "shortTitle": "LaTeX or Markdown Document…",
        "category": "OverLyX",
        "icon": "$(new-file)"
      },
      {
        "command": "overlyx.openInOverlyx",
        "title": "Open in OverLyX Editor",
        "category": "OverLyX",
        "icon": "$(preview)"
      },
      {
        "command": "overlyx.openAsText",
        "title": "Open as LaTeX Source (text editor)",
        "category": "OverLyX",
        "icon": "$(go-to-file)"
      },
      {
        "command": "overlyx.buildPdf",
        "title": "Build & View PDF",
        "category": "OverLyX",
        "icon": "$(file-pdf)"
      },
      {
        "command": "overlyx.syncToPdf",
        "title": "SyncTeX: Show Cursor in PDF",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.toggleMargin",
        "title": "Toggle Notes & Comments in the Margin",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.toggleCombined",
        "title": "Show Master and Child Documents in One View",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.refreshOutline",
        "title": "Refresh Structure",
        "category": "OverLyX",
        "icon": "$(refresh)"
      },
      {
        "command": "overlyx.checkForUpdates",
        "title": "Check for Updates",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.connectAgents",
        "title": "Connect AI Agents (Claude Code, Codex): Edits as Tracked Changes",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.disconnectAgents",
        "title": "Disconnect AI Agents",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.syncNow",
        "title": "Sync Now with the Server",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.syncPause",
        "title": "Pause Sync for This Folder",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.syncResume",
        "title": "Resume Sync for This Folder",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.syncShowLog",
        "title": "Show Sync Log",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.cloneProject",
        "title": "Clone Project from OverLyX…",
        "category": "OverLyX",
        "icon": "$(repo-clone)"
      },
      {
        "command": "overlyx.signIn",
        "title": "Sign In to OverLyX…",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.signOut",
        "title": "Sign Out of OverLyX…",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.syncMenu",
        "title": "Sync…",
        "category": "OverLyX"
      },
      {
        "command": "overlyx.editorKey",
        "title": "Editor key (handled by the OverLyX editor)",
        "category": "OverLyX"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "overlyx",
          "title": "OverLyX",
          "icon": "assets/overlyx.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overlyx.structure",
        "contents": "The outline of the document open in the OverLyX editor appears here.\n[New Slide Deck](command:overlyx.newSlides)\n[New Document…](command:overlyx.newDocument)",
        "when": "!overlyx.active"
      },
      {
        "view": "explorer",
        "contents": "Work on a project from OverLyX (overlyx.app): it stays in step with the server while it is open here.\n[Clone an OverLyX Project](command:overlyx.cloneProject)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "views": {
      "overlyx": [
        {
          "id": "overlyx.structure",
          "name": "Structure",
          "contextualTitle": "OverLyX Structure"
        }
      ],
      "explorer": [
        {
          "id": "overlyx.structureExplorer",
          "name": "OverLyX Structure",
          "when": "overlyx.active",
          "contextualTitle": "OverLyX Structure"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        { "command": "overlyx.openPdf", "when": "resourceExtname =~ /^\\.[pP][dD][fF]$/", "group": "open" }
      ],
      "file/newFile": [
        { "command": "overlyx.newSlides", "group": "file" },
        { "command": "overlyx.newPoster", "group": "file" },
        { "command": "overlyx.newWebPage", "group": "file" },
        { "command": "overlyx.newDocument", "group": "file" }
      ],
      "editor/title": [
        {
          "command": "overlyx.openPdf",
          "when": "resourceExtname =~ /^\\.[pP][dD][fF]$/ && activeCustomEditorId != overlyx.pdfViewer",
          "group": "navigation"
        },
        {
          "command": "overlyx.openInOverlyx",
          "when": "resourceExtname =~ /^\\.(tex|md|markdown)$/ && activeCustomEditorId != overlyx.texEditor",
          "group": "navigation"
        },
        {
          "command": "overlyx.openDeliverable",
          "when": "resourceExtname =~ /^\\.html?$/ && activeCustomEditorId != overlyx.htmlEditor",
          "group": "navigation"
        },
        {
          "command": "overlyx.openAsText",
          "when": "activeCustomEditorId == overlyx.texEditor || overlyx.articleActive",
          "group": "navigation"
        },
        {
          "command": "overlyx.buildPdf",
          "when": "activeCustomEditorId == overlyx.texEditor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "overlyx.refreshOutline",
          "when": "view == overlyx.structure",
          "group": "navigation"
        },
        {
          "command": "overlyx.refreshOutline",
          "when": "view == overlyx.structureExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        { "command": "overlyx.editorKey", "when": "false" },
        { "command": "overlyx.syncMenu", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "overlyx.editorKey",
        "key": "f5",
        "when": "activeCustomEditorId == overlyx.htmlEditor && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "overlyx.editorKey",
        "key": "shift+f5",
        "when": "activeCustomEditorId == overlyx.htmlEditor && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "overlyx.editorKey",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "activeCustomEditorId == overlyx.htmlEditor && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "overlyx.editorKey",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == overlyx.htmlEditor && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "overlyx.buildPdf",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeCustomEditorId == overlyx.texEditor || overlyx.articleActive"
      },
      {
        "command": "overlyx.syncToPdf",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "activeCustomEditorId == overlyx.texEditor || overlyx.articleActive"
      },
      { "command": "overlyx.editorKey", "key": "ctrl+k", "mac": "cmd+k", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "ctrl+j", "mac": "cmd+j", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "ctrl+\\", "mac": "cmd+\\", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "ctrl+b", "mac": "cmd+b", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "ctrl+m", "mac": "cmd+m", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "ctrl+shift+m", "mac": "cmd+shift+m", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "f5", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" },
      { "command": "overlyx.editorKey", "key": "shift+f5", "when": "(activeCustomEditorId == overlyx.texEditor || overlyx.articleActive) && !inputFocus && !panelFocus && !sideBarFocus && !auxiliaryBarFocus && !terminalFocus" }
    ],
    "configuration": {
      "title": "OverLyX",
      "properties": {
        "overlyx.developmentPath": {
          "type": "string", "default": "", "scope": "machine",
          "description": "OverLyX source checkout for live development. Restart the window after changing this path."
        },
        "overlyx.developmentServer": {
          "type": "string", "default": "http://127.0.0.1:18765", "scope": "machine",
          "description": "Development server on the extension host. Used when developmentPath is set."
        },
        "overlyx.layoutDir": {
          "type": "string",
          "default": "",
          "description": "Directory with LyX layout files. Empty: the copy bundled with the extension (or LYX_LAYOUT_DIR)."
        },
        "overlyx.latexmk": {
          "type": "string",
          "default": "latexmk",
          "description": "latexmk executable used to build PDFs."
        },
        "overlyx.defaultEditor": {
          "type": "boolean",
          "default": false,
          "description": "Open .tex files in the OverLyX editor by default: keeps the *.tex entry of workbench.editorAssociations pointing at the OverLyX editor (off: files open in the text editor; use “Reopen Editor With…” or the editor-title button)."
        },
        "overlyx.updates": {
          "type": "string",
          "enum": [
            "prompt",
            "auto",
            "off"
          ],
          "default": "prompt",
          "description": "Self-update from GitHub releases (the extension is installed from a .vsix, so VS Code does not update it): ask before installing, install silently, or only check via the “OverLyX: Check for Updates” command."
        },
        "overlyx.updateRepo": {
          "type": "string",
          "default": "japhba/overlyx",
          "description": "GitHub repository (owner/name) whose releases provide updates."
        },
        "overlyx.updateApi": {
          "type": "string",
          "default": "",
          "description": "Override the release-check endpoint (testing / self-hosted mirrors). Leave empty."
        },
        "overlyx.sync.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Keep clones of OverLyX projects in step with the server while VS Code is open: files you save reach the project within seconds, changes made there arrive here, and the branch follows the server's commits — no pull, commit or push. Applies to workspace folders whose git remote is a project on overlyx.app (or on a server listed in `#overlyx.sync.servers#` or signed in with the OverLyX CLI). Pause a single folder from the status bar.",
          "tags": [
            "usesOnlineServices"
          ]
        },
        "overlyx.sync.servers": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Further OverLyX servers (e.g. `https://latex.example.org`) whose project clones are synced, besides overlyx.app and the servers the OverLyX CLI is signed in to."
        },
        "overlyx.usageStatistics": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Send anonymous action, outcome and performance categories to overlyx.app to diagnose editing, PDF, canvas, build and sync problems. Requires VS Code's telemetry level All. Uses random IDs only for this activation or webview load; never sends document text, clipboard contents, filenames, workspace paths, URLs, accounts or persistent device IDs. Detailed events are kept for 30 days. Switching off clears queued events immediately.",
          "tags": ["telemetry", "usesOnlineServices"]
        },
        "overlyx.errorReports": {
          "type": "boolean",
          "default": true,
          "description": "Send sanitized extension errors to overlyx.app so maintainers can diagnose installer problems. Also follows VS Code's global telemetry level. Never sends documents, filenames, workspace paths, account details, email, or stable machine IDs.",
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ]
        }
      }
    }
  },
  "scripts": {
    "dev:live": "node scripts/live.mjs",
    "dev:service": "node scripts/install-live-service.mjs",
    "test:live": "node --import tsx test/liveTest.mts",
    "package:live": "node scripts/package-live.mjs",
    "dev": "concurrently -n host,webview -c blue,green \"node esbuild.mjs --watch\" \"vite build --watch --config webview.vite.config.ts\"",
    "build": "node esbuild.mjs && vite build --config webview.vite.config.ts && node scripts/copy-assets.mjs && node scripts/build-runtime.mjs",
    "build:host": "node esbuild.mjs",
    "build:webview": "vite build --config webview.vite.config.ts",
    "package": "vsce package --no-dependencies",
    "test:integration": "xvfb-run -a node test/runTest.mjs",
    "test:gui": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node test/guiTest.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.0",
    "@vscode/test-electron": "^2.4.1",
    "zod": "^4.5.2"
  }
}
