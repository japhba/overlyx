{
  "name": "overlyx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
    "build": "npm run build -w packages/client",
    "start": "npm run start -w packages/server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:beta": "node scripts/check-beta.mjs",
    "test:release": "bash scripts/check-unit-release.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "happy-dom": "^21.0.4",
    "jsdom": "30.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "GPL-3.0-or-later"
}
