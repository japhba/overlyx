[Unit]
Description=OverLyX: check and deploy origin/master (scripts/autodeploy.sh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=LYX_LAYOUT_DIR=/root/lyx/lib/layouts
Environment=OVERLYX_PRODUCTION=/root/lyx/overlyx-production
Environment=OVERLYX_SITE_URL=https://overlyx.app
ExecStart=/bin/bash /root/lyx/overlyx-production/scripts/autodeploy.sh
TimeoutStartSec=40min
Nice=5
