# Receives mail for privacy@ / contact@overlyx.app (packages/server/src/mailin.ts) and never sends or
# forwards any: each message becomes a JSON file in /var/lib/overlyx-mailin, which the OverLyX server
# moves into its reports (inbox.ts) — the administrators read them in Settings ▸ Account.
# Runs as a throwaway unprivileged user that may bind port 25 and nothing else; the code is the
# production checkout, read-only. Install: cp deploy/overlyx-mailin.service /etc/systemd/system/ &&
# systemctl daemon-reload && systemctl enable --now overlyx-mailin
[Unit]
Description=OverLyX: receive mail for privacy@ / contact@ (never forwards)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=overlyx-mailin
StateDirectoryMode=0700
Environment=MAILIN_PORT=25 MAILIN_HOST=0.0.0.0 MAILIN_DOMAIN=overlyx.app MAILIN_RECIPIENTS=privacy,contact MAILIN_DIR=/var/lib/overlyx-mailin
BindReadOnlyPaths=/root/lyx/overlyx-production:/opt/overlyx
WorkingDirectory=/opt/overlyx
ExecStart=/usr/bin/node --import tsx packages/server/src/mailin.ts
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=64
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
