[Unit]
Description=OverLyX collaborative LyX/LaTeX editor
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/lyx/overlyx
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=OVERLYX_DATA_DIR=/root/lyx/overlyx/data
Environment=OVERLYX_PROJECTS_DIR=/root/projects
Environment=LYX_LAYOUT_DIR=/root/lyx/lib/layouts
Environment=NODE_ENV=production
# Fronted by Caddy (deploy/Caddyfile): app binds localhost:8080, Caddy serves https://overlyx.app on 443
# Set these to enable "Sign in with Google" (OAuth redirect: <public url>/api/auth/google/callback)
## The instance owner: administrator, and owner of every pre-existing project directory
Environment=OVERLYX_OWNER_EMAIL=japhba@gmail.com
# OVERLYX_SIGNUP=invited would restrict Google sign-in to invited e-mail addresses (default: open)
# Every project is a git repository served at <public url>/git/<project>.git (needs git in PATH);
# OVERLYX_GIT=off disables it, OVERLYX_GIT_COMMIT_MS the idle time before OverLyX commits (default 2 min)
#Environment=OVERLYX_PUBLIC_URL=https://overlyx.example.org
# LaTeX builds and image conversions run in a bubblewrap sandbox (apt install bubblewrap);
# OVERLYX_SANDBOX=bwrap refuses to start without it, =none disables it (not recommended)
#Environment=OVERLYX_SANDBOX=bwrap
#Environment=GOOGLE_CLIENT_ID=...
#Environment=GOOGLE_CLIENT_SECRET=...
ExecStart=/usr/bin/npx tsx packages/server/src/index.ts
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
